{
  "name": "my-portfolio-cms",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:studio\"",
    "dev:next": "next dev",
    "dev:all": "concurrently \"npm run dev:next\" \"npm run dev:studio\"",
    "dev:studio": "sanity dev --port 3333",
    "build": "sanity build",
    "start": "next start",
    "lint": "next lint"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@portabletext/react": "^6.0.0",
    "@sanity/client": "^7.13.2",
    "@sanity/vision": "^6.13.1",
    "next": "^15.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^4.10.1",
    "react-player": "^3.0.0",
    "sanity": "^6.13.1",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@types/react": "^19.1",
    "concurrently": "^8.2.0",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
